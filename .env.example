# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-3.7-flash).
# Injected at runtime or set in Settings > Secrets.
GEMINI_API_KEY=

# RAZORPAY_KEY_ID: Razorpay test mode Key ID (e.g. rzp_test_...)
# Obtain from https://dashboard.razorpay.com/#/access/api-keys
RAZORPAY_KEY_ID=

# RAZORPAY_KEY_SECRET: Razorpay test mode Key Secret
RAZORPAY_KEY_SECRET=

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET=smartspend_jwt_secret_key_2026

